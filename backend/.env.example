# SentinelAI Backend Environment Variables
# Copy to .env and customize as needed

# YOLO Model Configuration
YOLO_MODEL_PATH=models/best.pt
YOLO_CONFIDENCE=0.40

# Alert Configuration
ALERT_COOLDOWN_SECONDS=3

# Server Configuration
HOST=0.0.0.0
PORT=8000
RELOAD=True

# Logging
LOG_LEVEL=info

# Authentication and access control
AUTH_ENABLED=true
# Generate a random value of at least 32 characters. Never commit the real value.
SENTINEL_AUTH_SECRET=replace-with-a-random-32-character-secret
AUTH_TOKEN_TTL_SECONDS=28800
# Optional first-admin bootstrap. Set only for initial setup, then remove or rotate.
SENTINEL_BOOTSTRAP_ADMIN_USERNAME=admin
SENTINEL_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-12-character-password

# Integration providers are simulation-safe by default.
GPS_MODE=simulation
DISPATCH_MODE=simulation

# Comma-separated frontend origins.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174