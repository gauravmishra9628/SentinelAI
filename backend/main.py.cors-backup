@app.get("/api/incidents", tags=["Incidents"])
async def get_incidents_endpoint(
    limit: int = 100,
    offset: int = 0,
    status: str = None,
    severity: str = None,
    camera_id: str = None,
    incident_type: str = None,
    search: str = None,
) -> dict[str, Any]:
    """List incidents with optional filtering.

    Search matches against incident ID, camera ID, event type, and location.
    """
    incidents = list_incidents(
        limit=limit,
        offset=offset,
        status=status,
        severity=severity,
        camera_id=camera_id,
        incident_type=incident_type,
        search=search,
    )
    counts = get_incident_counts()
    return {
        "incidents": incidents,
        "count": len(incidents),
        "total": counts.get("total", 0),
        "open": counts.get("new", 0) + counts.get("acknowledged", 0) + counts.get("investigating", 0),
        "resolved": counts.get("resolved", 0),
        "counts": counts,
    }


